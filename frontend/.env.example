# Copy to .env.local (git-ignored) to override. Vite reads this at dev/build time.

# Base URL of the ProRata FastAPI backend, without a trailing slash. API paths such
# as /api/groups are appended to it. The backend must allow this app's origin via
# CORS (PRORATA_CORS_ORIGINS) when the two run on different ports or hosts.
# Default when unset: http://localhost:8000
VITE_API_BASE_URL=http://localhost:8000
